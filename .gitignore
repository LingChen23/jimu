# Keil build products
**/_build/
**/Objects/
**/Listings/
**/output/
*.o
*.d
*.crf
*.dep
*.axf
*.map
*.lst
*.lnp
*.build_log.htm
tx_device/lib_nRF/components/softdevice/*/hex/*.sct

# ESP-IDF build products
**/build/
**/build_*/
**/build-*/
**/managed_components/
**/sdkconfig
**/sdkconfig.old
**/sdkconfig.gateway_uart
**/sdkconfig.gateway_uart.old
**/sdkconfig.gateway_*_uart
**/sdkconfig.gateway_*_uart.old

# Keil per-user state and backups
*.uvgui.*
*.uvguix.*
*.saved_uv4
*.orig
*.bak
*.tmp

# Debugger and generated logs
*.log
JLinkLog.txt
JLinkSettings.ini

# Python caches
__pycache__/
*.py[cod]

# Vue frontend generated files
vue_frontend/node_modules/
vue_frontend/dist/
vue_frontend/*.tsbuildinfo
vue_frontend/.env
vue_frontend/.env.*
!vue_frontend/.env.example

# Vue backend runtime state
vue_backend/runtime/

# Isolated cloud runtime and credentials
cloud_backend/.venv/
cloud_backend/runtime/
cloud_backend/.env
deploy/cloud/*.env
deploy/cloud/*.tar.gz

# Local editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Keys and credentials must never enter source control
*.pem
*.key
*.p12
*.pfx
