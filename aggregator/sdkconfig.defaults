# Board: LCKFB ESP32-S3 with ESP32-S3-WROOM-1-N16R8.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# The aggregator has no BLE role and never initializes the Wi-Fi driver.
CONFIG_BT_ENABLED=n

# Native USB Serial/JTAG is the binary PC business channel.
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_UART_CUSTOM=n
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL=0
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
CONFIG_LOG_DEFAULT_LEVEL=0
CONFIG_LOG_MAXIMUM_LEVEL=0

# Single-link gateway UART defaults.
CONFIG_SMARTBLOCK_AGGREGATOR_UART_PORT=1
CONFIG_SMARTBLOCK_AGGREGATOR_UART_BAUD=921600
CONFIG_SMARTBLOCK_AGGREGATOR_UART_TX_GPIO=17
CONFIG_SMARTBLOCK_AGGREGATOR_UART_RX_GPIO=18
