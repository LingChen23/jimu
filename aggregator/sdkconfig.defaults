# Board: LCKFB ESP32-S3 with ESP32-S3-WROOM-1-N16R8.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# The aggregator has no BLE role and never initializes the Wi-Fi driver.
CONFIG_BT_ENABLED=n

# Native USB Serial/JTAG is the binary PC business channel.
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_UART_CUSTOM=n
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL=0
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
CONFIG_LOG_DEFAULT_LEVEL=0
CONFIG_LOG_MAXIMUM_LEVEL=0

# Three independent full-duplex gateway links.
CONFIG_SMARTBLOCK_AGGREGATOR_UART_BAUD=921600
CONFIG_SMARTBLOCK_AGGREGATOR_UART_RX_BUFFER_SIZE=16384
CONFIG_SMARTBLOCK_AGGREGATOR_UART_TX_BUFFER_SIZE=4096
CONFIG_SMARTBLOCK_AGGREGATOR_LINK_QUEUE_DEPTH=64
CONFIG_SMARTBLOCK_AGGREGATOR_USB_QUEUE_DEPTH=256
CONFIG_SMARTBLOCK_AGGREGATOR_MERGE_BURST=4

# Gateway A -> devices 1..4.
CONFIG_SMARTBLOCK_AGGREGATOR_A_UART_PORT=1
CONFIG_SMARTBLOCK_AGGREGATOR_A_TX_GPIO=17
CONFIG_SMARTBLOCK_AGGREGATOR_A_RX_GPIO=18

# Gateway B -> devices 5..8.
CONFIG_SMARTBLOCK_AGGREGATOR_B_UART_PORT=2
CONFIG_SMARTBLOCK_AGGREGATOR_B_TX_GPIO=15
CONFIG_SMARTBLOCK_AGGREGATOR_B_RX_GPIO=16

# Gateway C -> devices 9..12. UART0 is remapped away from the disabled console.
CONFIG_SMARTBLOCK_AGGREGATOR_C_UART_PORT=0
CONFIG_SMARTBLOCK_AGGREGATOR_C_TX_GPIO=5
CONFIG_SMARTBLOCK_AGGREGATOR_C_RX_GPIO=6
