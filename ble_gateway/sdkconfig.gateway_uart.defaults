# Gateway-to-aggregator UART build.
# Keep this as an independent complete profile so it never reuses or rewrites
# the stable direct-USB sdkconfig.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=n
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=4
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=185
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=8192
# Three gateway radios are colocated. -12 dBm reduces near-end interference;
# each nRF52832 still transmits its sensor notifications at +4 dBm.
CONFIG_BT_CTRL_DFT_TX_POWER_LEVEL_N12=y
CONFIG_BT_CTRL_CE_LENGTH_TYPE_CE=y

CONFIG_SMARTBLOCK_GATEWAY_TRANSPORT_UART=y
CONFIG_SMARTBLOCK_GATEWAY_UART_PORT=1
CONFIG_SMARTBLOCK_GATEWAY_UART_BAUD=921600
CONFIG_SMARTBLOCK_GATEWAY_UART_TX_GPIO=17
CONFIG_SMARTBLOCK_GATEWAY_UART_RX_GPIO=18
CONFIG_SMARTBLOCK_GATEWAY_UART_RX_BUFFER_SIZE=16384
CONFIG_SMARTBLOCK_GATEWAY_UART_TX_BUFFER_SIZE=32768

CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_UART_CUSTOM=n
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL=0
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
CONFIG_LOG_DEFAULT_LEVEL=0
CONFIG_LOG_MAXIMUM_LEVEL=0
