server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    root /opt/jimu-cloud/web;
    index index.html;
    access_log off;

    location = / {
        return 302 /cloud-history;
    }

    location ~ ^/cloud-history(?:/.*)?$ {
        try_files /index.html =404;
    }

    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location ^~ /api/history/ {
        proxy_pass http://127.0.0.1:8767;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 1800s;
        client_max_body_size 64k;
    }

    location = /api/tasks/archive {
        proxy_pass http://127.0.0.1:8767;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_request_buffering off;
        proxy_read_timeout 900s;
        client_max_body_size 100m;
    }

    location = /api/diagnostics/events {
        proxy_pass http://127.0.0.1:8767;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_read_timeout 30s;
        client_max_body_size 256k;
    }

    location ~ ^/api/tasks/[A-Za-z0-9_-]+/archive-status$ {
        proxy_pass http://127.0.0.1:8767;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 30s;
        client_max_body_size 64k;
    }

    location ~ ^/api/tasks/(result|movement-detail|movement-export\.(csv|json)|export\.zip|export-batch\.zip)$ {
        proxy_pass http://127.0.0.1:8767;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 1800s;
        client_max_body_size 64k;
    }

    location /api/ {
        return 404;
    }

    location / {
        try_files $uri =404;
    }
}
